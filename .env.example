# Copy to .env and fill in. Never commit the filled-in .env.

# SQLite locally. Point at Postgres in production — see the README.
DATABASE_URL="file:./dev.db"

# Long random string: openssl rand -base64 32
# Signs login cookies and encrypts stored Chaturbate URLs.
# Changing it signs everyone out.
SESSION_SECRET=""

# The one timezone every time is shown in.
APP_TIMEZONE="America/New_York"

# Dollars per token.
TOKEN_RATE_USD="0.05"

# "mock" (reads .live-mock.json) or "chaturbate" (real Events API).
PRESENCE_PROVIDER="mock"

# Shared secret the scheduler sends to POST /api/cron/poll.
CRON_SECRET=""
